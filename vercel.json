{
    "version": 2,
    "framework": "laravel",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "public/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.php"
        }
    ]
}